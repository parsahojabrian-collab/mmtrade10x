# Database (replace placeholders locally; never commit a populated .env)
DATABASE_URL="mysql://10x_user:CHANGE_ME@127.0.0.1:3306/10x"

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_API_ROOT=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# Admin authentication: use independent random values of at least 32 chars
ADMIN_SESSION_SECRET=
ADMIN_API_TOKEN=
ADMIN_LEGACY_TOKEN_ENABLED=false

# Public app and channels
MINI_APP_URL=https://YOUR_DOMAIN/miniapp
REQUIRED_CHANNELS=
REQUIRED_CHANNEL_LINKS=
ALLOW_NO_REQUIRED_CHANNELS=false

# API / reverse proxy
PORT=3000
API_PORT=3000
API_HOST=127.0.0.1
CORS_ORIGIN=https://YOUR_DOMAIN
