{
  "name": "10x-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "10X Telegram bot, web app and API platform",
  "workspaces": ["apps/api", "apps/bot"],
  "scripts": {
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:bot": "tsx watch apps/bot/src/index.ts",
    "start:api": "node dist/apps/api/src/index.js",
    "start:bot": "node dist/apps/bot/src/index.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.1.0",
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "grammy": "^1.35.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.19.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
