generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RegistrationStatus {
  STARTED
  PHONE_PENDING
  REGISTERED
  COMPLETE
}
enum RegistrationStage {
  STARTED
  CHANNELS_PENDING
  CONSENT_PENDING
  PHONE_PENDING
  REGISTERED
  MINI_APP_PENDING
  COMPLETE
}
enum ConsentType {
  PRIVACY_PROCESSING
  SMS_MARKETING
}
enum ConsentChannel {
  TELEGRAM
  WEBSITE
  MINI_APP
}
enum AdminRole {
  SUPER_ADMIN
  USER_MANAGER
  SUPPORT
  CONTENT_MANAGER
  ACADEMY_MANAGER
  CHALLENGE_MANAGER
  ANALYST
  MARKETING_MANAGER
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

model User {
  id                String             @id @default(cuid())
  telegramId        String?            @unique
  username          String?
  firstName         String?
  lastName          String?
  phone             String?
  registrationStatus RegistrationStatus @default(STARTED)
  registrationStage RegistrationStage  @default(STARTED)
  registrationSource String            @default("telegram")
  registeredAt      DateTime?
  lastActivityAt    DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  telegramAccount   TelegramAccount?
  consents          UserConsent[]
  stageHistory      RegistrationStageEvent[]
  membershipChecks  ChannelMembershipCheck[]
  auditLogs         AuditLog[]
  lessonProgress    LessonProgress[]
  tickets           SupportTicket[]
  notifications     Notification[]
  followUpJobs      FollowUpJob[]

  @@index([registrationStatus, lastActivityAt])
  @@index([registrationStage, lastActivityAt])
  @@index([phone])
}

model TelegramAccount {
  id                String   @id @default(cuid())
  userId            String   @unique
  telegramId        String   @unique
  chatId            String
  languageCode      String?
  isBot             Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserConsent {
  id          String         @id @default(cuid())
  userId      String
  type        ConsentType
  channel     ConsentChannel
  granted     Boolean
  wordingVersion String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type, createdAt])
}

model RegistrationStageEvent {
  id        String            @id @default(cuid())
  userId    String
  stage     RegistrationStage
  detail    Json?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model ChannelMembershipCheck {
  id          String   @id @default(cuid())
  userId      String
  channelId   String
  isMember    Boolean
  checkedAt   DateTime @default(now())
  errorCode   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, checkedAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String?
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([entityType, entityId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?
  progressPct Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String
  subject     String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]
  @@index([status, updatedAt])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderType String
  body      String
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  channel   String
  title     String
  body      String
  sentAt    DateTime?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, createdAt])
}

model FollowUpJob {
  id            String   @id @default(cuid())
  userId        String
  dueAt         DateTime
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, dueAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model Course {
  id          String        @id @default(cuid())
  title       String        @db.VarChar(200)
  description String?       @db.Text
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lessons     Lesson[]
  @@index([status, sortOrder])
}

model Lesson {
  id        String        @id @default(cuid())
  courseId  String
  title     String        @db.VarChar(200)
  summary   String?       @db.Text
  body      String?       @db.Text
  videoUrl  String?       @db.VarChar(500)
  sortOrder Int           @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@index([courseId, sortOrder])
}

enum PopupFrequency {
  ONCE
  EVERY_VISIT
}

model ContentPage {
  slug      String        @id @db.VarChar(60)
  title     String?       @db.VarChar(200)
  blocks    Json
  status    ContentStatus @default(DRAFT)
  updatedAt DateTime      @updatedAt
}

model Popup {
  id         String         @id @default(cuid())
  title      String         @db.VarChar(200)
  body       String         @db.Text
  imageUrl   String?        @db.VarChar(500)
  buttonText String?        @db.VarChar(80)
  buttonUrl  String?        @db.VarChar(500)
  pageSlug   String         @db.VarChar(60)
  frequency  PopupFrequency @default(ONCE)
  status     ContentStatus  @default(DRAFT)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  @@index([pageSlug, status])
}

model PopupView {
  id      String   @id @default(cuid())
  userId  String
  popupId String
  seenAt  DateTime @default(now())
  @@unique([userId, popupId])
}
